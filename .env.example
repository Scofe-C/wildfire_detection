# =============================================================================
# Wildfire Detection MLOps — Unified Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git (.gitignore already excludes it).
# =============================================================================

# === Required ===
FIRMS_MAP_KEY=                      # NASA FIRMS: https://firms.modaps.eosdis.nasa.gov/api/
GCS_BUCKET_NAME=wildfire-mlops-dev  # GCS bucket name
GCP_KEY_PATH=./gcp-key.json        # Path to service account JSON
GOOGLE_CLOUD_PROJECT=               # GCP project ID

# === LLM — OBJ-3 reports (need at least one) ===
GEMINI_API_KEY=                     # Google AI Studio: https://aistudio.google.com/app/apikey
LLM_BACKEND=gemini_dev              # gemini_dev | ollama | vertex_ai

# === Optional ===
SLACK_WEBHOOK_URL=                  # Slack alerts (skipped if empty)
GCP_REGION=us-central1              # GCP region for cloud deploy
MLFLOW_TRACKING_URI=sqlite:///mlruns.db  # MLflow backend