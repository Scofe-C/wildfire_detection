# =============================================================================
# PyroWatch Wildfire MLOps — Environment Variables
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. Place gcp-key.json in this directory (wildfire_detection/)
# NEVER commit .env or gcp-key.json to Git.
# =============================================================================

# ---------------------------------------------------------------------------
# Required — pipeline won't start without these
# ---------------------------------------------------------------------------

# NASA FIRMS API key — get free at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# Google Cloud Storage bucket (ask team lead for the shared bucket name)
GCS_BUCKET_NAME=wildfire-mlops-123

# Path to GCP service account JSON (ask team lead for this file)
GCP_KEY_PATH=./gcp-key.json

# GCP project ID
GOOGLE_CLOUD_PROJECT=wildfire-mlops-123

# ---------------------------------------------------------------------------
# LLM — OBJ-3 Disaster Reporter (need at least one)
# ---------------------------------------------------------------------------

# Google Gemini API key — get free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# LLM backend to use: gemini_dev | ollama | vertex_ai
LLM_BACKEND=gemini_dev

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Slack webhook for pipeline alerts
SLACK_WEBHOOK_URL=

# Email recipients for failures (comma-separated)
ALERT_EMAIL_RECIPIENTS=

# GCP region (must match your GCS bucket region)
GCP_REGION=us-central1

# GCS prefix written by Cloud Function watchdog trigger
WATCHDOG_TRIGGER_PREFIX=watchdog/triggers/

# Airflow Fernet key (leave blank to auto-generate)
AIRFLOW__CORE__FERNET_KEY=

# Airflow example DAGs (leave false)
AIRFLOW__CORE__LOAD_EXAMPLES=false
