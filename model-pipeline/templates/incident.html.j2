<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Incident Report — {{ incident_name }}</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 900px; margin: 0 auto; padding: 20px; color: #333; }
        h1 { color: #c0392b; border-bottom: 3px solid #c0392b; padding-bottom: 10px; }
        h2 { color: #2c3e50; margin-top: 30px; }
        .meta { background: #f8f9fa; padding: 15px; border-radius: 6px; margin-bottom: 20px; }
        .meta span { display: inline-block; margin-right: 20px; }
        .status-active { color: #e74c3c; font-weight: bold; }
        .status-contained { color: #f39c12; font-weight: bold; }
        .status-controlled { color: #27ae60; font-weight: bold; }
        .status-out { color: #2ecc71; font-weight: bold; }
        table { border-collapse: collapse; width: 100%; margin: 10px 0; }
        th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }
        th { background: #34495e; color: white; }
        .actions li { margin-bottom: 8px; }
        .disclaimer { background: #fff3cd; padding: 12px; border: 1px solid #ffc107; border-radius: 4px; margin-top: 30px; font-style: italic; }
        .review-banner { background: #f8d7da; border: 2px solid #c0392b; border-radius: 6px; padding: 16px; margin: 20px 0; }
        @media print { body { max-width: 100%; } }
    </style>
</head>
<body>

<h1>🔥 Incident Report: {{ incident_name }}</h1>

<div class="meta">
    <span><strong>Report ID:</strong> {{ incident_id }}</span>
    <span><strong>Generated:</strong> {{ generated_at }}</span>
    <span><strong>Status:</strong> <span class="status-{{ incident_status|lower }}">{{ incident_status }}</span></span>
    <span><strong>Risk Level:</strong> {{ risk_level }}</span>
    <span><strong>Confidence:</strong> {{ "%.0f"|format(report_confidence * 100) }}%</span>
    <span><strong>Review Status:</strong> {{ review_status }}</span>
</div>

{% if review_status == "PENDING_REVIEW" %}
<div style="background: #f8d7da; border: 2px solid #c0392b; border-radius: 6px; padding: 16px; margin: 20px 0; font-size: 1.1em;">
    <strong>⚠️ PENDING HUMAN REVIEW</strong> — This report has not been approved by a human reviewer.
    {% if disagreement_flag %}<br>Reason: Model disagreement detected (satellite hotspots conflict with risk assessment).{% endif %}
    <br>Do not use for operational decisions until reviewed.
</div>
{% endif %}

<h2>Executive Summary</h2>
<p><strong>Operating Mode:</strong> {{ operating_mode }} | <strong>Human Review Required:</strong> {{ human_review_required }}</p>

<h2>Situation Status</h2>
<p>{{ spread_summary }}</p>
{% if estimated_area_acres %}
<p><strong>Estimated Area:</strong> {{ estimated_area_acres }} acres</p>
{% endif %}

<h2>Affected Communities</h2>
<ul>
{% for community in affected_communities %}
    <li>{{ community }}</li>
{% endfor %}
</ul>

<h2>Resource Requirements</h2>
<table>
    <thead>
        <tr><th>Resource Type</th><th>Quantity</th><th>ICS Type</th><th>Notes</th></tr>
    </thead>
    <tbody>
    {% for res in resource_requirements %}
        <tr>
            <td>{{ res.resource_type }}</td>
            <td>{{ res.quantity }}</td>
            <td>{{ res.ics_type if res.ics_type else "—" }}</td>
            <td>{{ res.notes if res.notes else "—" }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<h2>Projected Losses</h2>
<table>
    <tr><th>Structures at Risk</th><td>{{ projected_losses.structures_at_risk }}</td></tr>
    <tr><th>Population at Risk</th><td>{{ projected_losses.population_at_risk }}</td></tr>
    {% if projected_losses.infrastructure_notes %}
    <tr><th>Infrastructure</th><td>{{ projected_losses.infrastructure_notes }}</td></tr>
    {% endif %}
    {% if projected_losses.estimated_cost_usd %}
    <tr><th>Estimated Cost</th><td>${{ "%.2f"|format(projected_losses.estimated_cost_usd) }}</td></tr>
    {% endif %}
</table>

<h2>Vulnerable Populations</h2>
<table>
    <thead>
        <tr><th>Group</th><th>Location</th><th>Vulnerability Score</th><th>Notes</th></tr>
    </thead>
    <tbody>
    {% for group in vulnerable_populations %}
        <tr>
            <td>{{ group.group_name }}</td>
            <td>{{ group.location }}</td>
            <td>{{ "%.2f"|format(group.vulnerability_score) }}</td>
            <td>{{ group.notes if group.notes else "—" }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<h2>Immediate Actions</h2>
<ol class="actions">
{% for action in immediate_actions %}
    <li>{{ action }}</li>
{% endfor %}
</ol>

{% if operator_notes_incorporated %}
<h2>Operator Notes</h2>
<p>{{ operator_notes_incorporated }}</p>
{% endif %}

{% if ics_form_references %}
<h2>ICS Form References</h2>
<ul>
{% for ref in ics_form_references %}
    <li>{{ ref }}</li>
{% endfor %}
</ul>
{% endif %}

<h2>Data Sources</h2>
<ul>
{% for src in data_sources_used %}
    <li>{{ src }}</li>
{% endfor %}
</ul>

<div class="disclaimer">{{ disclaimer }}</div>

</body>
</html>
